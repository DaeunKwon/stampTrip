{
  "name": "stamp-trip",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "trending:snapshot": "node scripts/trending-snapshot.mjs",
    "trending:dry": "node scripts/trending-snapshot.mjs --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:web": "playwright test --project=web",
    "test:e2e:android": "playwright test --project=android",
    "test:e2e:ios": "playwright test --project=ios",
    "test:e2e:report": "playwright show-report e2e-results/report",
    "cap:sync": "vite build && cap sync",
    "android:build": "npm run cap:sync && cd android && ./gradlew assembleDebug -q",
    "android:run": "npm run cap:sync && cap run android",
    "android:open": "cap open android",
    "android:release": "bash scripts/android-release.sh",
    "store:shots": "node scripts/store-screenshots.mjs",
    "store:banner": "node scripts/store-banner.mjs",
    "ios:open": "cap open ios",
    "assets": "capacitor-assets generate --iconBackgroundColor #ffffff --iconBackgroundColorDark #1f2937 --splashBackgroundColor #ffffff --splashBackgroundColorDark #111827",
    "ios:build": "npm run cap:sync && xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Debug -sdk iphonesimulator -destination \"generic/platform=iOS Simulator\" build -quiet",
    "ios:testflight": "bash scripts/ios-testflight.sh"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@supabase/supabase-js": "^2.112.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "jsdom": "^24.1.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^4.5.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^0.34.6"
  }
}
